    $mappings{"cuGetErrorName"} = { rep => "hipDrvGetErrorName", type => "error" };
    $mappings{"cuGetErrorString"} = { rep => "hipDrvGetErrorString", type => "error" };
    $mappings{"cudaGetErrorName"} = { rep => "hipGetErrorName", type => "error" };
