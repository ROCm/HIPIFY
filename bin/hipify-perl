# Global Comment Masking to protect lit tests and documentation
my @masked_comments;
sub maskComments {
    my ($text_ref) = @_;
    @masked_comments = ();
    $$text_ref =~ s{("[^"\\]*(?:\\.[^"\\]*)*"|'[^'\\]*(?:\\.[^'\\]*)*')|(\/\/[^\n]*|\/\*[^*]*\*+(?:[^\/*][^*]*\*+)*\/)}{
        if (defined $2) {
            push @masked_comments, $2;
            "__HIPIFY_COMMENT_" . $#masked_comments . "__";
        } else {
            $1;
        }
    }ge;
}

sub unmaskComments {
    my ($text_ref) = @_;
    $$text_ref =~ s/__HIPIFY_COMMENT_(\d+)__/$masked_comments[$1]/ge;
}

