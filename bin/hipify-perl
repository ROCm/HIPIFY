    'cudnnRNNForwardInferenceEx' => 1,
    'cudnnRNNForwardTrainingEx' => 1,
    'cudnnRNNGetClip' => 1,
    'cudnnRNNGetClip_v8' => 1,
    'cudnnRNNGetClip_v9' => 1,
