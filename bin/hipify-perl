# CUDA Kernel Launch Syntax
sub transformKernelLaunch {
    no warnings qw/uninitialized/;
    my $k = 0;

    $k += s{([a-zA-Z_0-9:]+(?:\s*<[^>]+>)?)\s*<<<\s*(.+?)\s*>>>\s*(\(\s*\)|\()}{do {
        my ($f, $c, $p) = ($1, $2, $3);
        my (@a, $d, $cur);
        foreach my $s (split //, $c) {
            if ($s =~ /[\(\[\<]/) { $d++ } elsif ($s =~ /[\)\]\>]/) { $d-- }
            if ($s eq ',' && $d == 0) { push @a, $cur; $cur = '' } else { $cur .= $s }
        } push @a, $cur;
        for my $i (0 .. $#a) { my $v = $a[$i]; $v =~ s/^\s+|\s+$//g; $v = '0' if $v eq ''; $a[$i] = $v; }
        push @a, ('0', '0', '0');
        for my $i (0..1) { $a[$i] = "dim3($a[$i])" unless $a[$i] =~ /^dim3\b/; }
        $f = "HIP_KERNEL_NAME($f)" if $f =~ /</;
        my $res = "hipLaunchKernelGGL($f, $a[0], $a[1], $a[2], $a[3]" . ($p =~ /\)/ ? ")" : ", ");
        $res;
    }}gexs;

    if ($k) {
        $needs_hip_runtime = 1;
        $ft{'kernel_launch'} += $k if $print_stats;
    }
}

sub transformCubNamespace {
    s/using\s*namespace\s*cub/using namespace hipcub/g;
    s/\bcub::\b/hipcub::/g;
}

sub transformHostFunctions {
    my $process_args = sub {
        my ($f, $args_str, $argIdx, $actionType, $cast) = @_;
        my $args_inner = substr($args_str, 1, -1);
        my (@a, $d, $cur);
        foreach my $s (split //, $args_inner) {
            if ($s =~ /[\(\[\<\{]/) { $d++ } elsif ($s =~ /[\)\]\>\}]/) { $d-- }
            if ($s eq ',' && $d == 0) { push @a, $cur; $cur = '' } else { $cur .= $s }
        } push @a, $cur;
        if (defined $a[$argIdx]) {
            my $v = $a[$argIdx]; $v =~ s/^\s+|\s+$//g;
            if ($actionType == 0 || $actionType == 1) {
                $a[$argIdx] = "$cast($v)" unless index($v, $cast) == 0;
            } elsif ($actionType == 2) {
                splice(@a, $argIdx, 1);
            }
        }
        return "$f(" . join(',', @a) . ")";
    };

    s{\b(hipMemcpyToSymbol|hipMemcpyToSymbolAsync)\b\s*(\((?:[^()]+|(?2))*\))}{ $process_args->($1, $2, 0, 0, "HIP_SYMBOL") }ges;
    s{\b(hipGetSymbolAddress|hipGetSymbolSize|hipGetTextureReference|hipGraphMemcpyNodeSetParamsToSymbol|hipMemcpyFromSymbol|hipMemcpyFromSymbolAsync)\b\s*(\((?:[^()]+|(?2))*\))}{ $process_args->($1, $2, 1, 0, "HIP_SYMBOL") }ges;
    s{\b(hipFuncSetAttribute|hipFuncSetCacheConfig|hipFuncSetSharedMemConfig|hipLaunchCooperativeKernel|hipLaunchKernel)\b\s*(\((?:[^()]+|(?2))*\))}{ $process_args->($1, $2, 0, 1, "reinterpret_cast<const void*>") }ges;
    s{\b(hipFuncGetAttributes)\b\s*(\((?:[^()]+|(?2))*\))}{ $process_args->($1, $2, 1, 1, "reinterpret_cast<const void*>") }ges;
    s{\b(hipGraphExecMemcpyNodeSetParamsToSymbol|hipGraphMemcpyNodeSetParamsFromSymbol)\b\s*(\((?:[^()]+|(?2))*\))}{ $process_args->($1, $2, 2, 0, "HIP_SYMBOL") }ges;
    s{\b(hipModuleOccupancyMaxPotentialBlockSize|hipModuleOccupancyMaxPotentialBlockSizeWithFlags)\b\s*(\((?:[^()]+|(?2))*\))}{ $process_args->($1, $2, 3, 2, "") }ges;
    s{\b(hipGraphExecMemcpyNodeSetParamsFromSymbol)\b\s*(\((?:[^()]+|(?2))*\))}{ $process_args->($1, $2, 3, 0, "HIP_SYMBOL") }ges;
    s{\b(hipGraphAddMemcpyNodeToSymbol)\b\s*(\((?:[^()]+|(?2))*\))}{ $process_args->($1, $2, 4, 0, "HIP_SYMBOL") }ges;
    s{\b(hipGraphAddMemcpyNodeFromSymbol)\b\s*(\((?:[^()]+|(?2))*\))}{ $process_args->($1, $2, 5, 0, "HIP_SYMBOL") }ges;
}

